# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/
venv/

# Local secrets — never commit these
.env
.env.*
credentials.json

# Nothing under data/ is generated build output: the SQLite catalogues are tracked on
# purpose (see README), but transient SQLite side files must never be committed.
data/**/*-wal
data/**/*-shm
data/**/*.bak
data/**/*.tmp
